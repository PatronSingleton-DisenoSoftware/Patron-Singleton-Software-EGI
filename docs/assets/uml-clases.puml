@startuml uml-clases
' Diagrama de clases de la Sección II, alineado al código de src/.
' Renderizar con PlantUML y exportar como uml-clases.png para el documento de entrega.

skinparam classAttributeIconSize 0
skinparam shadowing false

title Sistema de Control de Acceso - Patrón Singleton (estructura actual)

class ControlAcceso {
  {static} -instancia : ControlAcceso
  -empleados : List<Empleado>
  -sectores : List<Sector>
  -permisos : List<Permiso>
  -registros : List<RegistroAcceso>
  -ControlAcceso()
  {static} +getInstance() : ControlAcceso
  +registrarEmpleado(empleado : Empleado) : void
  +registrarSector(sector : Sector) : void
  +asignarNivel(empleado : Empleado, nivelAcceso : NivelAcceso) : void
  +concederPermiso(permiso : Permiso) : void
  +revocarPermiso(permiso : Permiso) : void
  +verificarAcceso(numEmpleado : int, numSector : int) : boolean
  +consultarHistorial() : List<RegistroAcceso>
  +getEmpleados() : List<Empleado>
  +getSectores() : List<Sector>
  +getPermisos() : List<Permiso>
  +buscarEmpleado(identificacion : int) : Empleado
  +buscarSector(identificacion : int) : Sector
  -buscarPermiso(empleado : Empleado, sector : Sector) : Permiso
  -tienePermisoEspecialActivo(empleado : Empleado, sector : Sector) : boolean
}

class Empleado {
  -identificacion : int
  -dni : int
  -nombre : String
  -apellido : String
  -nivelAcesso : NivelAcceso
  +Empleado(identificacion : int, dni : int, nombre : String, apellido : String, nivelAcceso : NivelAcceso)
  +getIdentificacion() : int
  +getDni() : int
  +getNombre() : String
  +getApellido() : String
  +getNivelAcesso() : NivelAcceso
  +setNivelAcesso(nivelAcesso : NivelAcceso) : void
  +toString() : String
}

class Sector {
  -identificacion : int
  -nombre : String
  -nivelRequerido : NivelAcceso
  +Sector(identificacion : int, nombre : String, nivelRequerido : NivelAcceso)
  +getIdentificacion() : int
  +getNombre() : String
  +getNivelRequerido() : NivelAcceso
  +setIdentificacion(identificacion : int) : void
  +setNombre(nombre : String) : void
  +setNivelRequerido(nivelRequerido : NivelAcceso) : void
  +toString() : String
}

class Permiso {
  -empleado : Empleado
  -sector : Sector
  -activo : boolean
  -especial : boolean
  +Permiso(empleado : Empleado, sector : Sector, especial : boolean)
  +getEmpleado() : Empleado
  +getSector() : Sector
  +estaActivo() : boolean
  +esEspecial() : boolean
  +setEmpleado(empleado : Empleado) : void
  +setSector(sector : Sector) : void
  +setActivo(activo : boolean) : void
  +setEspecial(especial : boolean) : void
  +revocar() : void
  +toString() : String
}

class RegistroAcceso {
  {static} -FORMATO_FECHA_HORA : DateTimeFormatter
  -empleado : Empleado
  -sector : Sector
  -fechaHora : LocalDateTime
  -autorizado : boolean
  -motivo : String
  +RegistroAcceso(empleado : Empleado, sector : Sector, autorizado : boolean, motivo : String)
  +getEmpleado() : Empleado
  +getSector() : Sector
  +getFechaHora() : LocalDateTime
  +isAutorizado() : boolean
  +getMotivo() : String
  +setEmpleado(empleado : Empleado) : void
  +setSector(sector : Sector) : void
  +setFechaHora(fechaHora : LocalDateTime) : void
  +setAutorizado(autorizado : boolean) : void
  +setMotivo(motivo : String) : void
  +toString() : String
}

enum NivelAcceso {
  NIVEL_1(1, "Acceso General")
  NIVEL_2(2, "Acceso Interno")
  NIVEL_3(3, "Acceso Restringido")
  NIVEL_4(4, "Acceso Tecnico")
  NIVEL_5(5, "Acceso Directivo")
  -nivel : int
  -descripcion : String
  -NivelAcceso(nivel : int, descripcion : String)
  +getNivel() : int
  +getDescripcion() : String
  +alcanzaA(nivelRequerido : NivelAcceso) : boolean
  +toString() : String
}

class Main {
  {static} -leerEntero(entradaDatos : Scanner, mensaje : String) : int
  {static} -leerNombre(entradaDatos : Scanner, mensaje : String) : String
  {static} -leerNombreSector(entradaDatos : Scanner, mensaje : String) : String
  {static} -leerNivelAcceso(entradaDatos : Scanner) : NivelAcceso
  {static} +funcionRegistrarEmpleado(entradaDatos : Scanner, control : ControlAcceso) : void
  {static} +funcionRegistrarSector(entradaDatos : Scanner, control : ControlAcceso) : void
  {static} +funcionListarEmpleados(control : ControlAcceso) : void
  {static} +funcionListarSectores(control : ControlAcceso) : void
  {static} +funcionConcederPermiso(entradaDatos : Scanner, control : ControlAcceso) : void
  {static} +funcionRevocarPermiso(entradaDatos : Scanner, control : ControlAcceso) : void
  {static} +funcionVerificarAcceso(entradaDatos : Scanner, control : ControlAcceso) : void
  {static} +funcionConsultarHistorial(control : ControlAcceso) : void
  {static} +main(args : String[]) : void
}

ControlAcceso "1" o-- "*" Empleado : administra
ControlAcceso "1" o-- "*" Sector : administra
ControlAcceso "1" o-- "*" Permiso : concede y revoca
ControlAcceso "1" o-- "*" RegistroAcceso : conserva
ControlAcceso ..> NivelAcceso : consulta y asigna
Permiso --> Empleado
Permiso --> Sector
RegistroAcceso --> Empleado
RegistroAcceso --> Sector
Empleado --> NivelAcceso
Sector --> NivelAcceso
Main ..> ControlAcceso : usa el Singleton

@enduml
